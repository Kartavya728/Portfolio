# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# local backup of the previous Next.js site
/old-ui/

# build output
/dist

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Sentry Config File
.sentryclirc

# Ignore large media files, except the featured-project demo videos that
# actually need to ship with the site.
*.mp4
!public/featured/*.mp4

# Per-style meshes produced by scripts/style_gen (~116MB across all
# styles). The PNG renders they're compared by are committed; the meshes
# themselves are regenerable with `python scripts/style_gen/run_all.py`
# and would bloat the repo permanently.
public/models/*/model.glb
public/models/character_final_v16_stylized_realism.glb
public/models/character_final_v16_toon.glb
